{
    "name": "liry24-com",
    "private": true,
    "workspaces": [
        ".",
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "postinstall": "nuxt prepare",
        "dev": "nuxt dev",
        "build": "cf build",
        "build:nuxt": "nuxt build",
        "preview": "wrangler dev --experimental-new-config --persist-to .data/unified",
        "deploy": "cf deploy",
        "preview:deploy": "node scripts/preview.mjs deploy",
        "preview:delete": "node scripts/preview.mjs delete",
        "typecheck": "nuxt typecheck",
        "lint": "oxlint app server scripts tests packages",
        "format": "oxfmt . --write",
        "format:check": "oxfmt . --check",
        "test": "bun run test:unit && bun run test:worker",
        "test:unit": "bun test ./tests/*.test.ts",
        "test:worker": "vitest run --config vitest.worker.config.ts",
        "test:local": "node --env-file=.env scripts/test-site-admin-local.mjs",
        "content:generate": "site-admin generate --auth server/auth.config.ts --auth-use-plural --out packages/database/src/schema.ts && oxfmt packages/database/src/schema.ts --write && drizzle-kit generate --config drizzle.config.ts",
        "content:migrate": "node scripts/migrate-local-database.mjs"
    },
    "dependencies": {
        "@better-auth/drizzle-adapter": "1.7.6",
        "@better-auth/passkey": "1.7.6",
        "@comark/nuxt": "0.7.0",
        "@formkit/drag-and-drop": "^0.6.1",
        "@iconify-json/mingcute": "^1.2.8",
        "@iconify-json/simple-icons": "^1.2.97",
        "@liria24/site-admin": "0.0.0",
        "@nuxt/image": "^2.1.0",
        "@nuxt/ui": "^4.11.2",
        "@nuxtjs/better-auth": "^0.3.5",
        "@repo/database": "workspace:*",
        "@takumi-rs/core": "2.14.0",
        "@takumi-rs/wasm": "2.14.0",
        "@tanstack/vue-form": "2.0.0-alpha.2",
        "@vueuse/nuxt": "^15.0.0",
        "@yeger/vue-masonry-wall": "^6.1.4",
        "better-auth": "1.7.6",
        "cn": "^0.4.0",
        "drizzle-orm": "1.0.0-rc.4",
        "files-sdk": "^2.6.0",
        "motion-v": "^2.5.0",
        "nuxt": "^4.5.2",
        "nuxt-files-sdk": "^0.1.1",
        "ufo": "^1.6.4",
        "vue": "3.6.0-rc.9"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "^0.22.0",
        "@cloudflare/workers-types": "^5.20260927.1",
        "@nuxt/a11y": "^1.0.0-alpha.1",
        "@nuxt/hints": "^1.1.4",
        "@types/bun": "^1.4.2",
        "@types/node": "^26.6.3",
        "cf": "1.0.0-beta.7",
        "drizzle-kit": "1.0.0-rc.4",
        "es-module-lexer": "^3.0.2",
        "oxfmt": "^0.70.0",
        "oxlint": "^1.85.0",
        "oxlint-tsgolint": "^7.0.2003",
        "playwright-core": "^1.63.0",
        "taze": "^21.1.0",
        "typescript": "^6.0.3",
        "vitest": "^5.0.2",
        "vue-tsc": "^3.3.11",
        "wrangler": "^4.142.0"
    },
    "overrides": {
        "@vue/compiler-sfc": "3.6.0-rc.9",
        "vue": "3.6.0-rc.9"
    },
    "packageManager": "bun@1.4.2"
}
