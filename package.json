{
    "name": "liry24-com",
    "private": true,
    "type": "module",
    "scripts": {
        "postinstall": "nuxt prepare",
        "dev": "nuxt dev",
        "build": "nuxt build",
        "preview": "wrangler dev --persist-to .data/worker-preview",
        "deploy": "wrangler deploy",
        "preview:deploy": "node scripts/preview.mjs deploy",
        "preview:delete": "node scripts/preview.mjs delete",
        "typecheck": "nuxt typecheck",
        "lint": "oxlint app server scripts tests",
        "format": "oxfmt . --write",
        "format:check": "oxfmt . --check",
        "test": "vitest run",
        "test:local": "node scripts/test-site-admin-local.mjs",
        "content:generate": "site-admin generate --auth server/auth.config.ts --auth-use-plural --out server/database/schema.ts && oxfmt server/database/schema.ts --write && drizzle-kit generate --config drizzle.config.ts"
    },
    "dependencies": {
        "@ai-sdk/openai": "^4.0.93",
        "@better-auth/drizzle-adapter": "1.7.8",
        "@better-auth/passkey": "1.7.8",
        "@comark/nuxt": "0.7.0",
        "@formkit/drag-and-drop": "^0.6.1",
        "@iconify-json/mingcute": "^1.2.8",
        "@iconify-json/simple-icons": "^1.2.100",
        "@liria24/site-admin": "0.0.3",
        "@nuxt/image": "^2.1.0",
        "@nuxt/ui": "^4.11.3",
        "@takumi-rs/core": "2.16.2",
        "@takumi-rs/wasm": "2.16.2",
        "@tanstack/vue-form": "2.0.0-alpha.2",
        "@vueuse/nuxt": "^15.0.0",
        "@yeger/vue-masonry-wall": "^6.1.4",
        "cn": "^0.4.0",
        "drizzle-orm": "1.0.0-rc.4",
        "motion-v": "^2.7.0",
        "nuxt": "^4.6.1",
        "ufo": "^1.6.4",
        "vue": "3.6.0-rc.11",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261015.1",
        "@nuxt/a11y": "^1.0.0-alpha.1",
        "@nuxt/fonts": "1.0.1",
        "@nuxt/hints": "^1.1.5",
        "@types/node": "^26.6.5",
        "cf": "1.0.0-beta.17",
        "drizzle-kit": "1.0.0-rc.4",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "oxlint-tsgolint": "^7.0.2004",
        "playwright-core": "^1.64.1",
        "taze": "^21.3.0",
        "typescript": "^6.0.3",
        "vitest": "^5.0.4",
        "vue-tsc": "^3.3.13",
        "wrangler": "^4.151.0"
    },
    "overrides": {
        "@vue/compiler-sfc": "3.6.0-rc.11",
        "vue": "3.6.0-rc.11"
    },
    "packageManager": "bun@1.4.3",
    "patchedDependencies": {
        "better-auth@1.7.7": "patches/better-auth@1.7.7.patch",
        "better-call@1.4.0": "patches/better-call@1.4.0.patch",
        "@nuxt/hints@1.1.5": "patches/@nuxt%2Fhints@1.1.5.patch"
    }
}
