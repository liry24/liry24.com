{
    "name": "liry24-com",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "postinstall": "nuxt prepare",
        "dev": "nuxt dev",
        "build": "nuxt build",
        "preview": "wrangler dev --config .output/server/wrangler.json",
        "deploy": "wrangler deploy --config .output/server/wrangler.json --keep-vars",
        "typecheck": "nuxt typecheck",
        "lint": "oxlint",
        "format": "oxfmt . --write",
        "format:check": "oxfmt . --check",
        "test": "vitest run",
        "test:mutation": "node node_modules/@mizchi/mutator/dist/cli.js",
        "dev:inspect": "NUXT_DIAGNOSTICS=1 nuxt dev",
        "test:a11y": "LIRY24_TEST_ACCESSIBILITY_BROWSER=true vitest run tests/worker/accessibility.browser.test.ts"
    },
    "dependencies": {
        "@ai-sdk/google": "4.0.125",
